.instructions/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Django
*.log
/staticfiles/
local_settings.py

# Secrets — never commit. See .env.example for the required keys.
.env
.env.*
!.env.example
/secrets/

# Counselee data must never reach the repo. These are the runtime directories at
# the root of the checkout, and the leading slash is load-bearing: an unanchored
# `documents/` matches a directory of that name at ANY depth, which silently
# swallowed the whole of apps/documents/ and templates/documents/ — 24 source
# files that were never committed and whose absence first showed up as an isort
# error in CI, because ruff could no longer resolve `apps.documents`.
/documents/
/media/
/backups/

# Written by scripts/bootstrap.sh, and describes one host rather than the
# application: which encrypted dataset the volumes live on. Committing it would put
# one ministry's layout in everybody's checkout, and would make an upgrade a merge
# conflict against a local edit.
/docker-compose.override.yml

# No longer generated: a LAN install sets CADDY_TLS in .env instead, because a copy
# of the Caddyfile mounted over the tracked one stopped receiving the security
# header changes made after it was written. Still ignored so that upgrading an
# install that has one left over does not present it as something to commit.
/compose/caddy/Caddyfile.local

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
