# Copy to .env and fill in. Never commit the real file.
#
# Generate the two keys with:
#   DJANGO_SECRET_KEY:      python -c "import secrets; print(secrets.token_urlsafe(64))"
#   BCTRACKER_MASTER_KEY:   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
LOG_LEVEL=INFO

# Production only.
DJANGO_ALLOWED_HOSTS=counseling.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://counseling.example.org
# Move the admin off the default path. The real protection is superuser-only
# access, but this keeps bots out of the logs.
DJANGO_ADMIN_URL_PATH=admin

# --- Database -------------------------------------------------------------
POSTGRES_DB=bctracker
POSTGRES_USER=bctracker
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Document encryption --------------------------------------------------
# CRITICAL: this key decrypts every stored document. If it is lost, every
# document becomes permanently unreadable, backups included. Back it up sealed
# and offline, stored SEPARATELY from the database and document backups.
BCTRACKER_MASTER_KEY=
DOCUMENT_STORE_ROOT=/var/lib/bctracker/documents
DOCUMENT_MAX_BYTES=26214400
# What an uploaded image is compressed towards on ingest — not a limit, a budget.
# Quality is lowered first and dimensions only after that; an image that will not fit
# is stored at the smallest attempt rather than refused. Raise it if photographed
# paperwork is coming out too soft to read; lower it if the volume is filling up.
DOCUMENT_IMAGE_TARGET_BYTES=1048576

# --- Sessions -------------------------------------------------------------
SESSION_IDLE_TIMEOUT_SECONDS=1800

# --- Backups --------------------------------------------------------------
# The nightly job writes an encrypted pg_dump here, verifies it, and deletes ones
# older than BACKUP_KEEP_DAYS — never the newest, however old it is. Only the cron
# service mounts this directory.
#
# The dump is sealed with BCTRACKER_MASTER_KEY, so that key is now what stands
# between a copied backup and every counseling record in it — and losing the key
# loses the backups too. Keep the sealed copy of the key somewhere the backups are
# not.
#
# This directory is on the same host as the database, which protects against a
# mistake and not against a fire. Copying it off-box is a separate step, and so is
# rehearsing the restore: docs/restore-drill.md.
BACKUP_ROOT=/var/lib/bctracker/backups
BACKUP_KEEP_DAYS=14

# How long a used or expired login link is kept before the purge job deletes the
# row. Only a hash of the link is ever stored; the window is for answering "where
# was this used from".
LOGIN_TOKEN_RETENTION_DAYS=30

# --- Addresses -------------------------------------------------------------
# The address counselees reach the site at. Used for the links in reminder and
# invitation emails, and for the Google OAuth redirect URI — which has to match
# what is registered in the Google console character for character.
SITE_BASE_URL=https://counseling.example.org
# The same hostname without the scheme. Caddy requests a certificate for it, so
# it must resolve to this host from the internet. Compose refuses to start
# without it rather than serving on a hostname nobody meant.
SITE_HOSTNAME=counseling.example.org
# Left empty for an internet-facing install, where Caddy gets a real certificate
# from Let's Encrypt. Set it to `tls internal` for a LAN-only or evaluation
# install, where that hostname cannot be reached from the internet and Caddy's own
# CA is the only way to serve https at all. Browsers will warn about the
# certificate until the CA is trusted; see docs/deployment.md.
CADDY_TLS=

# --- Time -----------------------------------------------------------------
# The ministry's local timezone. Counselor office hours are interpreted here.
ORG_TIME_ZONE=America/New_York

# --- Email (any SMTP provider) -------------------------------------------
# These are the fallback. The real place to configure mail is inside the
# application: sign in as an administrator, open Email settings, and enter the
# mailbox and its password there. What is stored in the database wins over what is
# here, and the password is encrypted with BCTRACKER_MASTER_KEY rather than
# written to this file — which is readable by anybody who can read the host.
#
# If you do set EMAIL_HOST_PASSWORD here, it must be an app password rather than
# the account's own: Google Workspace requires one and refuses the account
# password outright, and Zoho requires one whenever two-factor authentication is
# on. Either way the sending account needs 2FA switched on to be issued one.
#
# Google Workspace: smtp.gmail.com, port 587. Zoho: smtp.zoho.com on a free or
# personal account and smtppro.zoho.com on a custom domain, port 587 — or port
# 465 with EMAIL_USE_SSL=true, which Zoho documents as the alternative. Check
# Zoho's own server-configuration page if the account is not in the .com
# datacenter, because the hostname carries the region.
#
# Leave DEFAULT_FROM_EMAIL empty rather than deleting the line; it falls back to
# EMAIL_HOST_USER, and then to the address configured in the application.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# Implicit TLS on 465 instead of STARTTLS on 587. There is no setting for "no
# encryption": leaving this false means STARTTLS, not plaintext.
EMAIL_USE_SSL=false
EMAIL_HOST_USER=counseling@example.org
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=counseling@example.org
# The email backend. Only change this to
# django.core.mail.backends.console.EmailBackend for a dry run, or to
# django.core.mail.backends.locmem.EmailBackend in a test harness. The default
# reads its host and credentials from the settings above and from the database.
# EMAIL_BACKEND=apps.core.mail.ConfiguredEmailBackend

# --- Google Calendar (optional) -------------------------------------------
# Leave GOOGLE_CALENDAR_ENABLED unset and the integration does not exist: no
# counselor is offered it and nothing reaches for the network.
#
# To switch it on, create an OAuth client of type "Web application" in the Google
# Cloud console, enable the Google Calendar API on the project, and register the
# redirect URI exactly:
#
#   https://counseling.example.org/availability/google/callback/
#
# GOOGLE_WORKSPACE_DOMAIN is not cosmetic. It is checked against the hosted-domain
# claim Google returns, so a counselor cannot connect a personal gmail.com account
# and have ministry appointments written to a calendar the ministry does not
# control. A production deployment with the integration on refuses to start
# without it.
GOOGLE_CALENDAR_ENABLED=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=example.org
# What a counselor's Google calendar shows. Anything here is readable on a lock
# screen, in a notification, and on any display that calendar is mirrored to, so
# it deliberately says nothing about who the appointment is with.
GOOGLE_EVENT_TITLE=Counseling appointment
GOOGLE_SYNC_HORIZON_DAYS=90

# Let ministry staff sign in with their Workspace account instead of a password
# here. Uses the same OAuth client, so register this redirect URI as well:
#
#   https://counseling.example.org/login/google/callback/
#
# Counselees are never included — they keep a password or an emailed link. Staff
# still have to enter a TOTP code afterwards: Google's response says nothing
# reliable about whether a second factor was used, so it is not accepted as one.
# Switched off in practice unless GOOGLE_WORKSPACE_DOMAIN is set, because without
# a domain to check "sign in with Google" would not restrict which account may.
GOOGLE_SSO_ENABLED=

# --- Billing ---------------------------------------------------------------
# One currency, stated here so the assumption is visible rather than spelled "$"
# in fourteen templates. Changing it after invoices exist does not restate the
# old ones — an invoice's amount is a historical fact.
BILLING_CURRENCY=usd
# Days from issue to due date, used as the default when an invoice is raised.
BILLING_DUE_DAYS=30
# The prefix on the reference a counselee quotes on a check: BC-000042. Leave it
# alone once invoices have been issued; the sequence behind it is not restarted.
BILLING_INVOICE_PREFIX=BC

# --- Stripe (optional) -----------------------------------------------------
# Leave STRIPE_ENABLED unset and there is no card payment: no button is
# rendered, the webhook refuses everything, and the reconciliation job exits
# saying so. Invoices still work end to end, paid by cash or check and recorded
# by hand — which is how a ministry that has not signed up for Stripe already
# operates.
#
# To switch it on you need two secrets from the Stripe dashboard, and they are
# different things:
#
#   STRIPE_SECRET_KEY     — sk_live_… Authorises outbound calls. Never a
#                           publishable key; the app has no client-side Stripe.
#   STRIPE_WEBHOOK_SECRET — whsec_… Shown once when the endpoint is created, at
#                           https://counseling.example.org/billing/stripe/webhook/
#                           for the events checkout.session.completed and
#                           payment_intent.payment_failed.
#
# Without the webhook secret that endpoint would be an unauthenticated "mark
# this invoice paid" route open to the internet, so a production deployment with
# Stripe on refuses to start without it (deploy check billing.E004).
STRIPE_ENABLED=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# How far out of date a delivery's own timestamp may be before it is refused.
# Stripe's documented default, and what stops a captured request being replayed
# tomorrow: the signature stays valid for ever, the timestamp does not.
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_API_BASE=https://api.stripe.com/v1
STRIPE_HTTP_TIMEOUT_SECONDS=20
# What a counselee sees on the hosted payment page and on their card statement.
# Deliberately says nothing but the ministry's name: a card statement is read by
# whoever opens the post, and "Biblical counseling" on it is a disclosure the
# ministry did not make and cannot withdraw. Stripe uppercases the descriptor and
# allows 5–22 characters; leave it blank to use the account's default.
STRIPE_STATEMENT_DESCRIPTOR=
STRIPE_PAYMENT_LABEL=Counseling services
