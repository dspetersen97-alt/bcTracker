# Caddy terminates TLS and proxies to the app. Certificates are obtained and
# renewed automatically via Let's Encrypt, which requires this host to be
# reachable from the internet on ports 80 and 443.
#
# For a LAN-only deployment, set SITE_HOSTNAME to the internal hostname and
# CADDY_TLS to `tls internal` in .env — see the placeholder below.

{$SITE_HOSTNAME} {
	# Empty on an internet-facing install, `tls internal` on a LAN one, where
	# Let's Encrypt cannot reach the host and its own CA is the only option.
	#
	# A placeholder rather than a second copy of this file with the line added.
	# The copy is how a LAN deployment came to be serving `frame-src 'none'`
	# months after that stopped being the policy: it was generated once at
	# install, was never regenerated, and — being untracked, since it names one
	# host — nothing here could notice it had frozen. Every security header
	# below is worth exactly as much as the deployment's ability to receive a
	# change to it, so the host's one choice is a variable and this file is the
	# only file the container reads.
	{$CADDY_TLS}
	encode zstd gzip

	# Security headers. Django sets several of these too; having them here means
	# they apply even to responses that bypass Django middleware.
	header {
		# Caddy's `header` replaces rather than appends, so this value
		# wins over the one Django's middleware sets. It reads the same
		# variable as SECURE_HSTS_SECONDS, with the same default, so
		# there is one knob to turn when raising max-age after the
		# deployment is known good.
		Strict-Transport-Security "max-age={$SECURE_HSTS_SECONDS:3600}; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# SAMEORIGIN, not DENY: the document page frames its own preview
		# route, and this header is enforced on the framed response. Matches
		# X_FRAME_OPTIONS in config/settings/base.py, where the reasoning is.
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "same-origin"
		# No third-party scripts, styles, or frames, and no inline anything.
		# The only frame is this site showing a counselor a document it is
		# already serving them, so 'self' is as far as frame-src and
		# frame-ancestors go.
		#
		# MUST match CONTENT_SECURITY_POLICY in config/settings/base.py, which
		# is where the reasoning for each directive is written down. Caddy's
		# `header` replaces rather than appends, so this copy is the one a
		# browser sees and a silent difference between the two would mean
		# testing one policy and shipping another. tests/test_security_headers.py
		# reads this file and fails if they drift.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
		Permissions-Policy "accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Resource-Policy "same-origin"
		# Do not advertise the server software.
		-Server
	}

	# Documents can be large and are decrypted as they stream, so allow a
	# generous read timeout on the proxy.
	reverse_proxy web:8000 {
		header_up X-Forwarded-Proto {scheme}
		transport http {
			read_timeout 120s
		}
	}

	# Cap request bodies. The application enforces its own per-document limit;
	# this stops an oversized upload before it reaches Python at all.
	request_body {
		max_size 30MB
	}

	log {
		output stdout
		format console
	}
}
